NODE_ENV=production
PORT=9000
DATABASE_URL=postgresql://user:password@host:5432/database
REDIS_URL=redis://default:password@host:6379
JWT_SECRET=generate-a-long-random-secret
COOKIE_SECRET=generate-another-long-random-secret
STORE_CORS=https://furialeather.bg,https://www.furialeather.bg
ADMIN_CORS=http://localhost:9000
AUTH_CORS=https://furialeather.bg,https://www.furialeather.bg,https://api.furialeather.bg
MEDUSA_BACKEND_URL=https://api.furialeather.bg
MEDUSA_WORKER_MODE=server
DISABLE_MEDUSA_ADMIN=false
STOREFRONT_URL=https://furialeather.bg

# Optional customer Google login. Set all four values together.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://furialeather.bg/account/google-callback
AUTH_MFA_ENCRYPTION_KEY=generate-a-long-random-secret
